in-h-screen px-4 bg-[#0A111E] text-white font-sans relative overflow-hidden\">\n      {/* Background glow */}\n      <div className=\"absolute top-1/4 left-1/2 -translate-x-1/2 w-96 h-96 bg-[#FF5A65]/10 rounded-full blur-3xl pointer-events-none\" />\n\n      <div className=\"bg-[#121B2B] border border-white/10 rounded-3xl w-full max-w-md p-8 sm:p-10 shadow-2xl relative space-y-6\">\n        \n        {/* Header */}\n        <div className=\"flex flex-col items-center text-center space-y-2\">\n          <div className=\"flex items-center gap-2 mb-2\">\n            <span className=\"text-2xl font-black tracking-tight text-white\">LAYO</span>\n            <span className=\"bg-[#FF5A65]/20 text-[#FF5A65] border border-[#FF5A65]/40 text-[9px] font-black px-2 py-0.5 rounded uppercase tracking-widest\">\n              Admin Portal\n            </span>\n          </div>\n          <h1 className=\"text-xl font-extrabold text-white\">Master Console Sign In</h1>\n          <p className=\"text-[#94A3B8] text-xs\">\n            Restricted access for Layo Operations &amp; Platform Administrators\n          </p>\n        </div>\n\n        {error && (\n          <div className=\"p-3.5 bg-red-500/10 border border-red-500/25 text-red-400 text-xs rounded-xl font-medium leading-relaxed text-center\">\n            {error}\n          </div>\n        )}\n\n        <form className=\"space-y-4\" onSubmit={handleAdminLogin}>\n          <div className=\"space-y-1.5\">\n            <label className=\"text-[10px] uppercase font-bold tracking-wider text-[#94A3B8] block\">\n              Admin Email\n            </label>\n            <input\n              type=\"email\"\n              placeholder=\"admin@layo.com\"\n              value={email}\n              onChange={e => setEmail(e.target.value)}\n              required\n              className=\"w-full bg-[#0A111E] border border-white/10 rounded-xl px-4 py-3 text-xs text-white placeholder:text-white/30 focus:border-[#FF5A65] focus:outline-none transition-all\"\n            />\n          </div>\n\n          <div className=\"space-y-1.5\">\n            <div className=\"flex items-center justify-between\">\n              <label className=\"text-[10px] uppercase font-bold tracking-wider text-[#94A3B8] block\">\n                Password\n              </label>\n            </div>\n            <input\n              type=\"password\"\n              placeholder=\"••••••••\"\n              value={password}\n              onChange={e => setPassword(e.target.value)}\n              required\n              className=\"w-full bg-[#0A111E] border border-white/10 rounded-xl px-4 py-3 text-xs text-white placeholder:text-white/30 focus:border-[#FF5A65] focus:outline-none transition-all\"\n            />\n          </div>\n\n          <button\n            type=\"submit\"\n            disabled={isLoading}\n            className=\"w-full py-3.5 bg-[#FF5A65] hover:bg-[#e24550] text-white font-black text-xs uppercase tracking-widest rounded-xl transition-all shadow-lg active:scale-[0.99] flex items-center justify-center gap-2 cursor-pointer mt-2\"\n          >\n            {isLoading ? (\n              <>\n                <span className=\"material-symbols-outlined animate-spin text-sm\">progress_activity</span>\n                <span>Verifying Access...</span>\n              </>\n            ) : (\n              <>\n                <span className=\"material-symbols-outlined text-sm\">admin_panel_settings</span>\n                <span>Enter Admin Console</span>\n              </>\n            )}\n          </button>\n        </form>\n\n        {/* Alternate Links */}\n        <div className=\"pt-4 border-t border-white/5 flex flex-col gap-2 text-center text-xs text-[#94A3B8]\">\n          <Link href=\"/ops/login\" className=\"hover:text-[#8BC34A] transition-colors font-medium text-[11px] flex items-center justify-center gap-1\">\n            <span className=\"material-symbols-outlined text-sm\">warehouse</span>\n            Warehouse Floor Staff Login ➔\n          </Link>\n          <Link href=\"/login\" className=\"hover:text-white transition-colors text-[11px]\">\n            Switch to Customer Locker Login\n          </Link>\n        </div>\n\n      </div>\n    </main>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/sharma/Desktop/Misc/Layo/src/app/admin/page.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'getDelhiveryRate' is defined but never used.","line":10,"column":99,"nodeType":"Identifier","messageId":"unusedVar","endLine":10,"endColumn":115,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"getDelhiveryRate"},"fix":{"range":[553,571],"text":""},"desc":"Remove unused variable \"getDelhiveryRate\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'formatTransactionId' is defined but never used.","line":12,"column":28,"nodeType":"Identifier","messageId":"unusedVar","endLine":12,"endColumn":47,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"formatTransactionId"},"fix":{"range":[759,780],"text":""},"desc":"Remove unused variable \"formatTransactionId\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'formatUserId' is defined but never used.","line":12,"column":67,"nodeType":"Identifier","messageId":"unusedVar","endLine":12,"endColumn":79,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"formatUserId"},"fix":{"range":[798,812],"text":""},"desc":"Remove unused variable \"formatUserId\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'formatOrderId' is defined but never used.","line":12,"column":100,"nodeType":"Identifier","messageId":"unusedVar","endLine":12,"endColumn":113,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"formatOrderId"},"fix":{"range":[831,846],"text":""},"desc":"Remove unused variable \"formatOrderId\"."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":