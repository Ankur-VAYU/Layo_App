ling setState() directly within an effect\n  489 |             setActiveDemoState(newActiveDemoState);\n  490 |             setSelectedCategories([...catsWithItems]);\n  491 |             // Pre-fill origin fields","line":488,"column":13,"nodeType":null,"endLine":488,"endColumn":24},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":520,"column":23,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":520,"endColumn":26,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[23398,23401],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[23398,23401],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":526,"column":44,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":526,"endColumn":47,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[23668,23671],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[23668,23671],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'e' is defined but never used.","line":528,"column":16,"nodeType":"Identifier","messageId":"unusedVar","endLine":528,"endColumn":17},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":536,"column":13,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":536,"endColumn":16,"suggestions":[{"messageId":"suggestUnknown",