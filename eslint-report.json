Type-II\", flat: \"11B\", colony: \"Danapur Staff Quarters\", location: \"Patna\", area: 65, bedrooms: 2, floor: 1, pool: \"General Pool\", rent: 940, status: \"Available\", amenities: [\"Parking\"] },\n  { id: \"P007\", type: \"Type-V\", flat: \"1A\", colony: \"Patna Sahib VIP Residency\", location: \"Patna\", area: 250, bedrooms: 5, floor: 0, pool: \"Secretary Pool\", rent: 5200, status: \"Occupied\", amenities: [\"Lift\", \"Parking\", \"Generator\", \"Security\", \"Garden\"] },\n  { id: \"P008\", type: \"Type-III\", flat: \"14C\", colony: \"Phulwari Staff Colony\", location: \"Patna Rural\", area: 88, bedrooms: 2, floor: 2, pool: \"General Pool\", rent: 1240, status: \"Available\", amenities: [\"Parking\", \"Garden\"] },\n];\n\nexport default function PropertiesPage() {\n  const [typeFilter, setTypeFilter] = useState(\"All\");\n  const [poolFilter, setPoolFilter] = useState(\"All\");\n  const [statusFilter, setStatusFilter] = useState(\"Available\");\n  const [search, setSearch] = useState(\"\");\n  const [selected, setSelected] = useState<string | null>(null);\n  const [showApply, setShowApply] = useState(false);\n  const [applyProp, setApplyProp] = useState<typeof PROPERTIES[0] | null>(null);\n  const [applyDone, setApplyDone] = useState(false);\n\n  const filtered = PROPERTIES.filter(p =>\n    (typeFilter === \"All\" || p.type === typeFilter) &&\n    (poolFilter === \"All\" || p.pool === poolFilter) &&\n    (statusFilter === \"All\" || p.status === statusFilter) &&\n    (search === \"\" || p.colony.toLowerCase().includes(search.toLowerCase()) || p.type.toLowerCase().includes(search.toLowerCase()))\n  );\n\n  return (\n    <div>\n      <div className=\"eniwas-page-header\">\n        <div className=\"eniwas-breadcrumb\">Dashboard / <span>Find Property</span></div>\n        <h2>Browse Available Properties</h2>\n        <p>Search & apply for government accommodation based on your eligibility</p>\n      </div>\n\n      <div className=\"eniwas-alert eniwas-alert-info\">\n        <span>ℹ️</span>\n        <span>You are eligible for <strong>Type-IV</strong> and <strong>Type-V</strong> properties based on your pay level (Level 11, IAS cadre).</span>\n      </div>\n\n      {/* Filters */}\n      <div className=\"eniwas-filter-bar\">\n        <div className=\"eniwas-search-box\">\n          <span className=\"icon material-symbols-outlined\">search</span>\n          <input className=\"eniwas-input\" placeholder=\"Search colony, location…\" value={search} onChange={e => setSearch(e.target.value)} />\n        </div>\n        <select className=\"eniwas-select\" style={{ width: \"auto\" }} value={typeFilter} onChange={e => setTypeFilter(e.target.value)}>\n          <option value=\"All\">All Types</option>\n          {[\"Type-I\",\"Type-II\",\"Type-III\",\"Type-IV\",\"Type-V\"].map(t => <option key={t}>{t}</option>)}\n        </select>\n        <select className=\"eniwas-select\" style={{ width: \"auto\" }} value={poolFilter} onChange={e => setPoolFilter(e.target.value)}>\n          <option value=\"All\">All Pools</option>\n          {[\"IAS/IPS Pool\",\"Secretary Pool\",\"General Pool\"].map(p => <option key={p}>{p}</option>)}\n        </select>\n        <select className=\"eniwas-select\" style={{ width: \"auto\" }} value={statusFilter} onChange={e => setStatusFilter(e.target.value)}>\n          <option value=\"All\">All Status</option>\n          <option value=\"Available\">Available Only</option>\n          <option value=\"Occupied\">Occupied</option>\n        </select>\n        <span style={{ fontSize: 12, color: \"#64748b\", marginLeft: \"auto\" }}>{filtered.length} properties found</span>\n      </div>\n\n      {/* Grid */}\n      <div className=\"property-grid\">\n        {filtered.map(p => (\n          <div key={p.id} className=\"property-card\" onClick={() => setSelected(selected === p.id ? null : p.id)}>\n            <div className=\"property-card-img\">\n              🏢\n              <span className=\"category-badge\">{p.type}</span>\n              <span className={`avail-badge badge ${p.status === \"Available\" ? \"badge-green\" : \"badge-gray\"}`}>\n                {p.status === \"Available\" ? \"✓ Available\" : \"Occupied\"}\n              </span>\n            </div>\n            <div className=\"property-card-body\">\n              <div className=\"property-card-title\">Flat {p.flat} – {p.colony}</div>\n              <div className=\"property-card-loc\">📍 {p.location} &nbsp;·&nbsp; Floor {p.floor === 0 ? \"Ground\" : p.floor}</div>\n              <div className=\"property-card-meta\">\n                <div className=\"property-card-meta-item\">🛏️ {p.bedrooms} BHK</div>\n                <div className=\"property-card-meta-item\">📐 {p.area} m²</div>\n                <div className=\"property-card-meta-item\">🏷️ {p.pool}</div>\n              </div>\n              <div style={{ display: \"flex\", gap: 4, flexWrap: \"wrap\", marginBottom: 10 }}>\n                {p.amenities.map(a => <span key={a} style={{ fontSize: 10, background: \"#f1f5f9\", color: \"#475569\", padding: \"2px 8px\", borderRadius: 10 }}>{a}</span>)}\n              </div>\n              <div style={{ display: \"flex\", justifyContent: \"space-between\", alignItems: \"center\" }}>\n                <div className=\"property-card-rent\">₹{p.rent.toLocaleString()} <span>/month</span></div>\n                {p.status === \"Available\" && (\n                  <button className=\"btn btn-primary btn-sm\" onClick={e => { e.stopPropagation(); setApplyProp(p); setShowApply(true); setApplyDone(false); }}>Apply</button>\n                )}\n              </div>\n            </div>\n          </div>\n        ))}\n      </div>\n\n      {/* Apply Modal */}\n      {showApply && applyProp && (\n        <div className=\"eniwas-modal-overlay\" onClick={() => setShowApply(false)}>\n          <div className=\"eniwas-modal\" onClick={e => e.stopPropagation()}>\n            {!applyDone ? (\n              <>\n                <div className=\"eniwas-modal-title\">Apply for Allotment</div>\n                <div className=\"eniwas-modal-sub\">Flat {applyProp.flat} – {applyProp.colony}</div>\n\n                <div className=\"eniwas-steps\" style={{ marginBottom: 20 }}>\n                  {[\"Property\", \"Preference\", \"Review\", \"Submit\"].map((s, i) => (\n                    <div key={s} className=\"eniwas-step\">\n                      <div className={`eniwas-step-circle ${i === 0 ? \"active\" : \"\"}`}>{i + 1}</div>\n                      <div className={`eniwas-step-label ${i === 0 ? \"active\" : \"\"}`}>{s}</div>\n                      {i < 3 && <div className=\"eniwas-step-line\" />}\n                    </div>\n                  ))}\n                </div>\n\n                <div style={{ background: \"#f8fafc\", borderRadius: 8, padding: 14, marginBottom: 16, fontSize: 13 }}>\n                  <div style={{ display: \"grid\", gridTemplateColumns: \"1fr 1fr\", gap: 8 }}>\n                    {[\n                      [\"Type\", applyProp.type],\n                      [\"Flat No.\", applyProp.flat],\n                      [\"Colony\", applyProp.colony],\n                      [\"Rent/Month\", `₹${applyProp.rent.toLocaleString()}`],\n                      [\"Pool\", applyProp.pool],\n                      [\"Area\", `${applyProp.area} m²`],\n                    ].map(([k, v]) => (\n                      <div key={k}><span style={{ color: \"#64748b\", fontSize: 11 }}>{k}</span><br /><strong>{v}</strong></div>\n                    ))}\n                  </div>\n                </div>\n\n                <div className=\"eniwas-form-group\">\n                  <label className=\"eniwas-label\">Reason for Request</label>\n                  <textarea className=\"eniwas-textarea\" placeholder=\"Briefly state your requirement for this accommodation…\" />\n                </div>\n                <div className=\"eniwas-form-group\">\n                  <label className=\"eniwas-label\">Preferred Move-in Date</label>\n                  <input className=\"eniwas-input\" type=\"date\" />\n                </div>\n                <div className=\"eniwas-form-group\">\n                  <label className=\"eniwas-label\">Preference Priority</label>\n                  <select className=\"eniwas-select\">\n                    <option>1st Choice</option>\n                    <option>2nd Choice</option>\n                    <option>3rd Choice</option>\n                  </select>\n                </div>\n\n                <div style={{ display: \"flex\", gap: 10, marginTop: 8 }}>\n                  <button className=\"btn btn-primary\" onClick={() => setApplyDone(true)}>Submit Request</button>\n                  <button className=\"btn btn-secondary\" onClick={() => setShowApply(false)}>Cancel</button>\n                </div>\n              </>\n            ) : (\n              <div style={{ textAlign: \"center\", padding: \"10px 0\" }}>\n                <div style={{ fontSize: 52, marginBottom: 12 }}>✅</div>\n                <div style={{ fontSize: 18, fontWeight: 700, color: \"#0d2b6b\", marginBottom: 8 }}>Request Submitted!</div>\n                <div style={{ fontSize: 13, color: \"#64748b\", marginBottom: 20 }}>\n                  Your allotment request for Flat {applyProp.flat} has been submitted.<br />\n                  Reference ID: <strong>REQ-2026-00{Math.floor(Math.random()*900+100)}</strong>\n                </div>\n                <div style={{ fontSize: 12, color: \"#475569\", background: \"#f8fafc\", borderRadius: 8, padding: \"10px 14px\", marginBottom: 20, textAlign: \"left\" }}>\n                  <div style={{ fontWeight: 600, marginBottom: 6 }}>What happens next?</div>\n                  <div>1. Allotment Committee reviews your request</div>\n                  <div>2. You will receive SMS/email on your registered mobile</div>\n                  <div>3. Typical processing time: 7–14 working days</div>\n                </div>\n                <button className=\"btn btn-primary\" onClick={() => setShowApply(false)}>Done</button>\n              </div>\n            )}\n          </div>\n        </div>\n      )}\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/sharma/Desktop/Misc/Layo/src/app/eniwas/user/rent/page.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'showReceipt' is assigned a value but never used.","line":7,"column":10,"nodeType":"Identifier","messageId":"unusedVar","endLine":7,"endColumn":21},{"ruleId":"react-hooks/purity","severity":2,"message":"Error: Cannot call impure function during render\n\n`Math.random` is an impure function. Calling an impure function can produce unstable results that update unpredictably when the component happens to re-render. (https://react.dev/reference/rules/components-and-hooks-must-be-pure#components-and-hooks-must-be-idempotent).\n\n/Users/sharma/Desktop/Misc/Layo/src/app/eniwas/user/rent/page.tsx:114:148\n  112 |             <div style={{ fontSize: 52, marginBottom: 12 }}>✅</div>\n  113 |             <div style={{ fontSize: 18, fontWeight: 700, color: \"#0d2b6b\", marginBottom: 6 }}>Payment Successful!</div>\n> 114 |             <div style={{ fontSize: 13, color: \"#64748b\", marginBottom: 16 }}>₹{total} paid for June 2026<br />Transaction ID: TXN26060{Math.floor(Math.random()*9000+1000)}</div>\n      |                                                                                                                                                    ^^^^^^^^^^^^^ Cannot call impure function\n  115 |             <button className=\"btn btn-secondary btn-sm\" onClick={() => setShowReceipt(true)}>📥 Download Receipt</button>\n  116 |             <div style={{ marginTop: 12 }}>\n  117 |               <button className=\"btn btn-secondary btn-sm\" onClick={() => setPayDone(false)}>Back</button>","line":114,"column":148,"nodeType":null,"endLine":114,"endColumn":161}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"\"use client\";\nimport { useState } from \"react\";\n\nexport default function RentPage() {\n  const [payTab, setPayTab] = useState<\"online\" | \"salary\">(\"online\");\n  const [payDone, setPayDone] = useState(false);\n  const [showReceipt, setShowReceipt] = useState(false);\n\n  const rentBreakdown = [\n    { label: \"Base Rent (Type-IV, 145m²)\", amount: 2560 },\n    { label: \"Water Charges\", amount: 120 },\n    { label: \"Maintenance Fund\", amount: 160 },\n  ];\n  const total = rentBreakdown.reduce((s, r) => s + r.amount, 0);\n\n  return (\n    <div>\n      <div className=\"eniwas-page-header\">\n        <div className=\"eniwas-breadcrumb\">Dashboard / <span>Rent & Payments</span></div>\n        <h2>Rent Management</h2>\n        <p>Pay rent, view history & manage payment preferences</p>\n      </div>\n\n      {/* Dues alert */}\n      <div className=\"eniwas-alert eniwas-alert-warning\">\n        <span>⚠️</span>\n        <div>\n          <strong>Rent Due for June 2026</strong> — ₹2,840 is due by <strong>10 Jun 2026</strong>.\n          A penalty of ₹284 (10%) will be levied after the due date.\n        </div>\n      </div>\n\n      {/* Rent summary banner */}\n      <div className=\"rent-summary\">\n        <div style={{ display: \"flex\", justifyContent: \"space-between\", flexWrap: \"wrap\", gap: 16 }}>\n          <div>\n            <div style={{ fontSize: 11, opacity: 0.7 }}>AMOUNT DUE – JUNE 2026</div>\n            <div className=\"rent-summary-amount\">₹2,840</div>\n            <div className=\"rent-summary-label\">Due by 10 Jun 2026 · Type-IV Flat 12B, Kadamkuan</div>\n          </div>\n          <div className=\"rent-summary-meta\">\n            <div className=\"rent-summary-meta-item\"><strong>₹0</strong>Arrears</div>\n            <div className=\"rent-summary-meta-item\"><strong>₹0</strong>Penalty</div>\n            <div className=\"rent-summary-meta-item\"><strong>6 days</strong>Until Due</div>\n          </div>\n        </div>\n      </div>\n\n      <div className=\"eniwas-grid-2\" style={{ marginBottom: 20 }}>\n        {/* Pay now */}\n        {!payDone ? (\n          <div className=\"eniwas-card\">\n            <div className=\"eniwas-card-title\"><span className=\"icon\">💳</span> Pay Rent – June 2026</div>\n\n            {/* Breakdown */}\n            <div style={{ background: \"#f8fafc\", borderRadius: 8, padding: 12, marginBottom: 16, fontSize: 13 }}>\n              {rentBreakdown.map(r => (\n                <div key={r.label} style={{ display: \"flex\", justifyContent: \"space-between\", marginBottom: 6 }}>\n                  <span style={{ color: \"#475569\" }}>{r.label}</span>\n                  <span style={{ fontWeight: 600 }}>₹{r.amount}</span>\n                </div>\n              ))}\n              <div style={{ display: \"flex\", justifyContent: \"space-between\", paddingTop: 8, borderTop: \"1px solid #e2e8f0\", fontWeight: 700, fontSize: 14, color: \"#0d2b6b\" }}>\n                <span>Total</span>\n                <span>₹{total}</span>\n              </div>\n            </div>\n\n            {/* Payment method tabs */}\n            <div className=\"eniwas-tabs\">\n              <button className={`eniwas-tab ${payTab === \"online\" ? \"active\" : \"\"}`} onClick={() => setPayTab(\"online\")}>💳 Online Payment</button>\n              <button className={`eniwas-tab ${payTab === \"salary\" ? \"active\" : \"\"}`} onClick={() => setPayTab(\"salary\")}>🏦 Salary Deduction</button>\n            </div>\n\n            {payTab === \"online\" ? (\n              <div>\n                <div style={{ display: \"flex\", gap: 10, marginBottom: 16, flexWrap: \"wrap\" }}>\n                  {[\"UPI\", \"Net Banking\", \"Debit Card\", \"Credit Card\"].map(m => (\n                    <label key={m} style={{ display: \"flex\", alignItems: \"center\", gap: 6, padding: \"8px 14px\", border: \"1px solid #e2e8f0\", borderRadius: 8, cursor: \"pointer\", fontSize: 13, background: m === \"UPI\" ? \"#eff3ff\" : \"white\", color: m === \"UPI\" ? \"#1a3a8f\" : \"#374151\", fontWeight: m === \"UPI\" ? 600 : 400 }}>\n                      <input type=\"radio\" name=\"paymode\" defaultChecked={m === \"UPI\"} style={{ accentColor: \"#1a3a8f\" }} />\n                      {m}\n                    </label>\n                  ))}\n                </div>\n                <div className=\"eniwas-form-group\">\n                  <label className=\"eniwas-label\">UPI ID</label>\n                  <input className=\"eniwas-input\" placeholder=\"yourname@upi\" />\n                </div>\n                <button className=\"btn btn-primary\" style={{ width: \"100%\", justifyContent: \"center\" }} onClick={() => setPayDone(true)}>\n                  Pay ₹{total} Now →\n                </button>\n              </div>\n            ) : (\n              <div>\n                <div className=\"eniwas-alert eniwas-alert-info\">\n                  <span>ℹ️</span>\n                  <span>A salary deduction request will be sent to HRMS. The amount will be deducted from your next salary.</span>\n                </div>\n                <div style={{ background: \"#f8fafc\", borderRadius: 8, padding: 12, fontSize: 13, marginBottom: 14 }}>\n                  <div><strong>HRMS Employee ID:</strong> BH-IAS-2019-00842</div>\n                  <div><strong>Deduction Month:</strong> June 2026</div>\n                  <div><strong>Amount to Deduct:</strong> ₹{total}</div>\n                </div>\n                <button className=\"btn btn-primary\" style={{ width: \"100%\", justifyContent: \"center\" }} onClick={() => setPayDone(true)}>\n                  Request Salary Deduction\n                </button>\n              </div>\n            )}\n          </div>\n        ) : (\n          <div className=\"eniwas-card\" style={{ textAlign: \"center\" }}>\n            <div style={{ fontSize: 52, marginBottom: 12 }}>✅</div>\n            <div style={{ fontSize: 18, fontWeight: 700, color: \"#0d2b6b\", marginBottom: 6 }}>Payment Successful!</div>\n            <div style={{ fontSize: 13, color: \"#64748b\", marginBottom: 16 }}>₹{total} paid for June 2026<br />Transaction ID: TXN26060{Math.floor(Math.random()*9000+1000)}</div>\n            <button className=\"btn btn-secondary btn-sm\" onClick={() => setShowReceipt(true)}>📥 Download Receipt</button>\n            <div style={{ marginTop: 12 }}>\n              <button className=\"btn btn-secondary btn-sm\" onClick={() => setPayDone(false)}>Back</button>\n            </div>\n          </div>\n        )}\n\n        {/* Payment history */}\n        <div className=\"eniwas-card\">\n          <div className=\"eniwas-card-title\"><span className=\"icon material-symbols-outlined\">receipt_long</span> Payment History</div>\n          <table className=\"eniwas-table\">\n            <thead>\n              <tr><th>Month</th><th>Amount</th><th>Mode</th><th>Status</th><th></th></tr>\n            </thead>\n            <tbody>\n              {[\n                { month: \"May 2026\", amount: 2840, mode: \"Online/UPI\", status: \"Paid\", txn: \"TXN260508411\" },\n                { month: \"Apr 2026\", amount: 2840, mode: \"Salary Ded.\", status: \"Paid\", txn: \"SAL260430022\" },\n                { month: \"Mar 2026\", amount: 2840, mode: \"Online/UPI\", status: \"Paid\", txn: \"TXN260310987\" },\n                { month: \"Feb 2026\", amount: 2840, mode: \"Online/UPI\", status: \"Paid\", txn: \"TXN260211344\" },\n                { month: \"Jan 2026\", amount: 3120, mode: \"Online/UPI\", status: \"Paid + Penalty\", txn: \"TXN260118004\" },\n                { month: \"Dec 2025\", amount: 2840, mode: \"Salary Ded.\", status: \"Paid\", txn: \"SAL251231100\" },\n              ].map(r => (\n                <tr key={r.month}>\n                  <td>{r.month}</td>\n                  <td style={{ fontWeight: 600 }}>₹{r.amount.toLocaleString()}</td>\n                  <td style={{ fontSize: 12 }}>{r.mode}</td>\n                  <td><span className={`badge ${r.status.includes(\"Penalty\") ? \"badge-orange\" : \"badge-green\"}`}>{r.status}</span></td>\n                  <td><button style={{ fontSize: 11, color: \"#0d2b6b\", background: \"none\", border: \"none\", cursor: \"pointer\" }}>↓</button></td>\n                </tr>\n              ))}\n            </tbody>\n          </table>\n        </div>\n      </div>\n\n      {/* Rent calculation details */}\n      <div className=\"eniwas-card\">\n        <div className=\"eniwas-card-title\"><span className=\"icon\">🧮</span> How Your Rent is Calculated</div>\n        <div style={{ display: \"grid\", gridTemplateColumns: \"repeat(auto-fill, minmax(200px, 1fr))\", gap: 16, fontSize: 13 }}>\n          {[\n            { label: \"Property Type\", value: \"Type-IV\" },\n            { label: \"Area\", value: \"145 sq.m.\" },\n            { label: \"Location Category\", value: \"Category A (Patna)\" },\n            { label: \"Base Rate\", value: \"₹17.65/sq.m.\" },\n            { label: \"Water Charge Rate\", value: \"₹0.83/sq.m.\" },\n            { label: \"Maintenance Rate\", value: \"₹1.10/sq.m.\" },\n            { label: \"Pay Level Factor\", value: \"1.0x (Level 11)\" },\n            { label: \"Penalty Rate\", value: \"10% after due date\" },\n          ].map(f => (\n            <div key={f.label} style={{ padding: \"10px 14px\", background: \"#f8fafc\", borderRadius: 8 }}>\n              <div style={{ fontSize: 11, color: \"#64748b\" }}>{f.label}</div>\n              <div style={{ fontWeight: 600, color: \"#0d2b6b\" }}>{f.value}</div>\n            </div>\n          ))}\n        </div>\n        <div style={{ marginTop: 14, fontSize: 12, color: \"#64748b\" }}>\n          * Rent calculated per Government of Bihar Housing Policy 2019 (amended 2023). Rates subject to revision.\n        </div>\n      </div>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/sharma/Desktop/Misc/Layo/src/app/faq/page.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/sharma/Desktop/Misc/Layo/src/app/forgot-password/page.tsx","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":27,"column":19,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":27,"endColumn":22,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[792,795],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[792,795],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"react/no-unescaped-entities","severity":2,"message":"`'` can be escaped with `&apos;`, `&lsquo;`, `&#39;`, `&rsquo;`.","line":41,"column":44,"nodeType":"JSXText","messageId":"unescapedEntityAlts","suggestions":[{"messageId":"replaceWithAlt","data":{"alt":"&apos;"},"fix":{"range":[1448,1546],"text":"\n            Enter your email address and we&apos;ll send you a link to reset your password.\n          "},"desc":"Replace with `&apos;`."},{"messageId":"replaceWithAlt","data":{"alt":"&lsquo;"},"fix":{"range":[1448,1546],"text":"\n            Enter your email address and we&lsquo;ll send you a link to reset your password.\n          "},"desc":"Replace with `&lsquo;`."},{"messageId":"replaceWithAlt","data":{"alt":"&#39;"},"fix":{"range":[1448,1546],"text":"\n            Enter your email address and we&#39;ll send you a link to reset your password.\n          "},"desc":"Replace with `&#39;`."},{"messageId":"replaceWithAlt","data":{"alt":"&rsquo;"},"fix":{"range":[1448,1546],"text":"\n            Enter your email address and we&rsquo;ll send you a link to reset your password.\n          "},"desc":"Replace with `&rsquo;`."}]}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"'use client';\n\nimport { useState } from 'react';\nimport Link from 'next/link';\nimport Logo from '@/components/Logo';\nimport { supabase } from '@/lib/supabase';\n\nexport default function ForgotPassword() {\n  const [email, setEmail] = useState('');\n  const [isLoading, setIsLoading] = useState(false);\n  const [error, setError] = useState<string | null>(null);\n  const [submitted, setSubmitted] = useState(false);\n\n  const handleReset = async (e: React.FormEvent) => {\n    e.preventDefault();\n    setIsLoading(true);\n    setError(null);\n\n    try {\n      const redirectTo = 'https://www.getlayo.com/reset-password';\n      const { error } = await supabase.auth.resetPasswordForEmail(email, {\n        redirectTo,\n      });\n\n      if (error) throw error;\n      setSubmitted(true);\n    } catch (err: any) {\n      setError(err.message || 'Failed to send password reset email. Please try again.');\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  return (\n    <main className=\"flex items-center justify-center min-h-[90vh] px-4 relative font-sans bg-[#F9F7F1]\">\n      <div className=\"bg-white border border-black/10 rounded-3xl w-full max-w-md p-8 shadow-sm relative space-y-6\">\n        <div className=\"flex flex-col items-center text-center space-y-3\">\n          <Logo showTagline={false} darkText={true} />\n          <h1 className=\"text-2xl font-extrabold text-[#0E1F38] mt-4\">Reset Password</h1>\n          <p className=\"text-[#0E1F38]/60 text-sm\">\n            Enter your email address and we'll send you a link to reset your password.\n          </p>\n        </div>\n\n        {error && (\n          <div className=\"p-3 bg-red-500/10 border border-red-500/20 text-red-400 text-xs rounded-xl font-bold text-center\">\n            {error}\n          </div>\n        )}\n\n        {submitted ? (\n          <div className=\"space-y-6 text-center\">\n            <div className=\"p-4 bg-green-500/10 border border-green-500/20 rounded-xl text-green-400 text-xs leading-relaxed font-medium\">\n              We have sent password reset instructions to <strong className=\"text-[#0E1F38]\">{email}</strong> if an account exists.\n            </div>\n            <p className=\"text-xs text-[#0E1F38]/60\">\n              Check your inbox and spam folder.\n            </p>\n            <Link\n              href=\"/login\"\n              className=\"block w-full py-4 bg-[#FF5A65] text-white font-bold text-xs uppercase tracking-widest rounded-xl hover:brightness-110 active:scale-[0.98] transition-all text-center\"\n            >\n              Back to Sign In\n            </Link>\n          </div>\n        ) : (\n          <form className=\"space-y-4\" onSubmit={handleReset}>\n            <div className=\"space-y-1\">\n              <label className=\"text-[10px] uppercase font-bold tracking-wider text-[#0E1F38]/60 block\">Email Address</label>\n              <input \n                type=\"email\" \n                placeholder=\"name@example.com\" \n                value={email}\n                onChange={(e) => setEmail(e.target.value)}\n                required\n                className=\"w-full bg-transparent border border-black/10 rounded-xl px-4 py-3 text-sm text-[#0E1F38] focus:border-[#FF5A65] focus:ring-0 focus:outline-none\"\n              />\n            </div>\n            \n            <button \n              className=\"w-full py-4 bg-[#FF5A65] text-white font-bold text-xs uppercase tracking-widest rounded-xl hover:brightness-110 active:scale-[0.98] transition-all disabled:opacity-50 mt-2 flex items-center justify-center gap-2\" \n              type=\"submit\" \n              disabled={isLoading}\n            >\n              {isLoading ? (\n                <>\n                  <span className=\"w-4 h-4 border-2 border-background/40 border-t-background rounded-full animate-spin\" />\n                  Sending Link...\n                </>\n              ) : 'Send Reset Link'}\n            </button>\n\n            <div className=\"pt-2 text-center\">\n              <Link href=\"/login\" className=\"text-xs text-[#0E1F38]/60 hover:text-[#0E1F38] transition-colors\">\n                ← Back to Sign In\n              </Link>\n            </div>\n          </form>\n        )}\n      </div>\n    </main>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/sharma/Desktop/Misc/Layo/src/app/how-it-works/page.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/sharma/Desktop/Misc/Layo/src/app/know-more/page.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'Image' is defined but never used.","line":5,"column":8,"nodeType":"Identifier","messageId":"unusedVar","endLine":5,"endColumn":13,"suggestions":[{"messageId":"removeUnusedImportDeclaration","data":{"varName":"Image"},"fix":{"range":[98,130],"text":""},"desc":"Remove unused import declaration."}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"'use client';\n\nimport { useState, useRef, useEffect } from 'react';\nimport Link from 'next/link';\nimport Image from 'next/image';\nimport Logo from '@/components/Logo';\nimport EstimatorModal from '@/components/EstimatorModal';\nimport { supabase } from '@/lib/supabase';\n\n// Step item structure for timeline\ninterface TimelineStep {\n  title: string;\n  desc: string;\n}\n\nconst NEW_USER_STEPS: TimelineStep[] = [\n  { title: 'Sign Up.', desc: 'Create your Layo account.' },\n  { title: 'Shop & Send.', desc: 'Shop from anywhere in India and send your orders to your Layo address.' },\n  { title: 'Enter Order Details', desc: 'Input the store name and your specific order or reference number.' },\n  { title: 'Build Your Shipment.', desc: 'Categorise items, add destinations, and shipping preferences.' },\n  { title: 'Ship or Hold', desc: 'Ship immediately, or hold to combine with up to 3 incoming packages.' },\n  { title: 'Review & Pay.', desc: 'Confirm details and complete payment.' },\n  { title: 'Track & Receive.', desc: 'Follow your shipment until it arrives.' },\n];\n\nconst EXISTING_USER_STEPS: TimelineStep[] = [\n  { title: 'Log In.', desc: 'Log in to your existing Layo account.' },\n  { title: 'Shop & Send.', desc: 'Shop from anywhere in India and send your orders to your Layo address.' },\n  { title: 'Enter Order Details', desc: 'Input the store name and your specific order or reference number.' },\n  { title: 'Build Your Shipment.', desc: 'Categorise items, add destinations, and shipping preferences.' },\n  { title: 'Ship or Hold', desc: 'Ship immediately, or hold to combine with up to 3 incoming packages.' },\n  { title: 'Review & Pay.', desc: 'Confirm details and complete payment.' },\n  { title: 'Track & Receive.', desc: 'Follow your shipment until it arrives.' },\n];\n\nconst PERSONAL_USER_STEPS: TimelineStep[] = [\n  { title: 'Select Personal Shipping', desc: 'Choose Personal/Home Package to start routing your everyday belongings or gifts.' },\n  { title: 'Enter Sender Details', desc: \"Enter the sender's name and the city the package is coming from.\" },\n  { title: 'Route Your Package', desc: 'Assign a warehouse and share its address with your sender (or use it to mail the package yourself), then enter your final delivery address.' },\n  { title: 'Ship or Hold', desc: 'Ship immediately, or hold to combine with up to 3 incoming packages.' },\n  { title: 'Review & Pay.', desc: 'Confirm details and complete payment.' },\n  { title: 'Track & Receive.', desc: 'Follow your shipment until it arrives.' },\n];\n\nconst FAQS_LIST = [\n  {\n    q: \"1. I can’t find my item category or have a special request. How do I add it?\",\n    a: \"If you are unsure which category fits your specific item, want to ship a unique product that isn't listed on our platform, or have general questions about what can be shipped, get in touch with us directly! Our support team is always available to help you figure out the best way to categorize and route your special items.\"\n  },\n  {\n    q: \"2. What happens if the actual weight of my items is different from the estimate?\",\n    a: \"Our system provides a smart estimate used for your initial booking. Once your items arrive at our warehouse, we verify their actual physical weight. If they weigh more than expected or were categorized differently, there are no penalty fees. We will simply send you an update detailing the exact difference and provide a 12-hour review window before any outstanding balance needs to be cleared for final dispatch.\"\n  },\n  {\n    q: \"3. How does the Hold & Combine feature work, and what are \\\"Extras\\\"?\",\n    a: \"Instead of shipping box by box, you can choose to hold your items at our warehouse and combine them with up to 3 additional incoming packages to build one cost-effective shipment. As you build your box, you can also include \\\"Extras\\\"—unlimited lightweight additions (like accessories and socks) that ship without impacting your overall weight class.\"\n  },\n  {\n    q: \"4. What if I realize I bought the wrong item and need to return it to the original store?\",\n    a: \"If you need to return a retail item, you must initiate the return before your final parcel is consolidated and packed for its final destination. Simply provide us with the digital return label generated by the original online store. A small processing fee applies for our team to print the label, attach it, and hand it to the courier. If a courier is coming to our facility to pick it up, we require 24 hours' advance notice.\"\n  },\n  {\n    q: \"5. Can I cancel my shipment or change my delivery address after my box is packed?\",\n    a: \"No. Once your items are received and our team has automatically consolidated and packed your final parcel for transit, the shipment is locked in. It cannot be canceled, modified, or halted, and shipping fees will not be refunded. Additionally, you must ensure your final delivery address is correct before your items arrive at our warehouse. We cannot reroute packages or issue refunds for deliveries sent to an incorrect address originally provided by you.\"\n  },\n  {\n    q: \"6. When will I get my tracking number?\",\n    a: \"Your unique tracking ID is generated and shared once we have received your items, combined your orders (if requested), verified the final weight, and your parcel is fully packed and ready to ship out to its final destination. You can easily find this tracking number in your account dashboard and monitor real-time updates from the moment it leaves our warehouse.\"\n  },\n  {\n    q: \"7. Are there any items I am not allowed to ship?\",\n    a: \"Yes. All shipments must comply with standard legal and carrier shipping policies. We cannot process or forward illegal, hazardous, or prohibited goods. Additionally, we strongly advise against shipping inherently fragile items or products prone to leaking (such as liquids, oils, or perishables). Layo does not accept liability for damages caused to or by these items during transit.\"\n  },\n  {\n    q: \"8. Can I estimate my shipping costs before I actually buy anything?\",\n    a: \"Absolutely. We offer a built-in Shipping Calculator so you can plan your smart haul. Simply select the categories of the items you plan to purchase to get a clear, upfront estimate. There is no commitment—you can check your estimated costs today and route your packages to our warehouse whenever you are ready.\"\n  },\n  {\n    q: \"9. Can I use Layo for personal packages sent by family or friends?\",\n    a: \"Yes! Layo is built for total flexibility. Whether it is a bulk order from an online store, an offline purchase at a local retailer, or a personal care package from home, simply provide the sender with the Layo warehouse address listed in your account, and we will seamlessly receive and manage your items.\"\n  }\n];\n\nexport default function KnowMorePage() {\n  // Tabbed timeline state\n  const [activeTab, setActiveTab] = useState<'new' | 'existing' | 'personal'>('new');\n  // FAQ accordion state\n  const [openFaqIdx, setOpenFaqIdx] = useState<number | null>(0);\n  // Estimator modal\n  const [modalOpen, setModalOpen] = useState(false);\n  // Contact form\n  const [contactForm, setContactForm] = useState({ name: '', contact: '', message: '' });\n  const [contactSubmitted, setContactSubmitted] = useState(false);\n\n  // Refs\n  const aboutRef = useRef<HTMLDivElement>(null);\n  const faqRef = useRef<HTMLDivElement>(null);\n  const contactRef = useRef<HTMLDivElement>(null);\n\n  const activeSteps = activeTab === 'new'\n    ? NEW_USER_STEPS\n    : activeTab === 'existing'\n      ? EXISTING_USER_STEPS\n      : PERSONAL_USER_STEPS;\n\n  useEffect(() => {\n    if (typeof window !== 'undefined' && window.location.hash) {\n      const hash = window.location.hash;\n      if (hash === '#contact' || hash === '#contact-section') {\n        setTimeout(() => {\n          contactRef.current?.scrollIntoView({ behavior: 'smooth' });\n        }, 150);\n      }\n    }\n  }, []);\n\n  const handleContactSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!contactForm.name || !contactForm.contact) return;\n\n    try {\n      // 1. Save to Database\n      const { error } = await supabase\n        .from('contact_submissions')\n        .insert([\n          {\n            name: contactForm.name,\n            contact: contactForm.contact,\n            message: contactForm.message,\n          }\n        ]);\n\n      if (error) {\n        console.error('Error saving contact submission to database:', error);\n      }\n    } catch (err) {\n      console.error('Failed to submit contact form:', err);\n    }\n\n\n\n    // 3. Update UI state\n    setContactSubmitted(true);\n    setTimeout(() => {\n      setContactForm({ name: '', contact: '', message: '' });\n      setContactSubmitted(false);\n    }, 5000);\n  };\n\n  return (\n    <div className=\"bg-[#FAF8EE] text-[#0E1F38] min-h-screen flex flex-col overflow-x-hidden relative font-sans\">\n\n      {/* ── HEADER ── */}\n      <header className=\"sticky top-0 w-full h-[10vh] z-[100] flex items-center justify-between px-6 md:px-16 bg-[#FAF8EE]/90 backdrop-blur-md border-b border-black/5 shadow-sm\">\n        <div className=\"flex items-center gap-4\">\n          <Link href=\"/\" className=\"text-[#0E1F38] hover:text-[#FF5A65] transition-colors\">\n            <span className=\"material-symbols-outlined text-2xl\">arrow_back</span>\n          </Link>\n          <Logo showTagline={false} darkText={true} />\n        </div>\n        <nav className=\"hidden md:flex items-center gap-8 font-semibold text-sm\">\n          <Link href=\"/know-more\" className=\"text-[#0E1F38] hover:text-[#FF5A65] transition-colors\">How it Works</Link>\n          <Link href=\"/shipping-policy\" className=\"text-[#0E1F38] hover:text-[#FF5A65] transition-colors\">Shipping Policy</Link>\n          <Link href=\"/login\" className=\"text-[#0E1F38] hover:text-[#FF5A65] transition-colors\">Sign Up/Log In</Link>\n        </nav>\n      </header>\n\n      {/* ───────────────────────────────────────\n          SECTION 1: HERO & INTERACTIVE TIMELINE\n      ─────────────────────────────────────── */}\n      <section className=\"py-20 px-6 md:px-16\">\n        <div className=\"max-w-5xl w-full mx-auto space-y-10\">\n\n          {/* Title */}\n          <div className=\"text-left space-y-2\">\n            <h1 className=\"text-4xl md:text-6xl font-black tracking-tight text-[#0E1F38]\">\n              Indian Shipping<br />\n              Made <span className=\"text-[#FF5A65] italic font-serif-luxury font-medium\">Easy.</span>\n            </h1>\n          </div>\n\n          {/* 3-Tab Selector */}\n          <div className=\"flex flex-wrap gap-2 border-b border-black/10 pb-4\">\n            <button\n              onClick={() => setActiveTab('new')}\n              className={`px-5 py-2.5 rounded-full text-xs font-bold transition-all cursor-pointer ${\n                activeTab === 'new'\n                  ? 'bg-[#d8e8c5] text-[#2b3a1a] shadow-sm ring-1 ring-[#b8d49a]'\n                  : 'bg-white/60 text-[#0E1F38]/60 hover:bg-white'\n              }`}\n            >\n              New users\n            </button>\n            <button\n              onClick={() => setActiveTab('existing')}\n              className={`px-5 py-2.5 rounded-full text-xs font-bold transition-all cursor-pointer ${\n                activeTab === 'existing'\n                  ? 'bg-[#f7c5b8] text-[#4a1c12] shadow-sm ring-1 ring-[#e8a392]'\n                  : 'bg-white/60 text-[#0E1F38]/60 hover:bg-white'\n              }`}\n            >\n              Existing Users\n            </button>\n            <button\n              onClick={() => setActiveTab('personal')}\n              className={`px-5 py-2.5 rounded-full text-xs font-bold transition-all cursor-pointer ${\n                activeTab === 'personal'\n                  ? 'bg-[#cbe6f7] text-[#14344d] shadow-sm ring-1 ring-[#9fcde8]'\n                  : 'bg-white/60 text-[#0E1F38]/60 hover:bg-white'\n              }`}\n            >\n              Home & Personal\n            </button>\n          </div>\n\n          {/* Personal belongings banner subtitle if active */}\n          {activeTab === 'personal' && (\n            <div className=\"bg-[#dcf0fa] border border-[#bce0f5] rounded-xl px-4 py-2.5 text-xs font-bold text-[#14344d]\">\n              For your everyday belongings & gifts.\n            </div>\n          )}\n\n          {/* Interactive Steps Timeline Layout */}\n          <div className=\"max-w-2xl relative pl-8 space-y-6 pt-2\">\n            {/* Vertical connecting line */}\n            <div className=\"absolute left-[11px] top-3 bottom-3 w-0.5 bg-[#0E1F38]\" />\n\n            {activeSteps.map((step, idx) => (\n              <div key={idx} className=\"relative flex items-start gap-4 group\">\n                {/* Timeline dot */}\n                <div className=\"absolute -left-[33px] top-1.5 w-3 h-3 rounded-full bg-[#0E1F38] border-2 border-[#FAF8EE] shadow-sm\" />\n                <div>\n                  <h3 className=\"text-base font-bold text-[#0E1F38] leading-snug\">{step.title}</h3>\n                  <p className=\"text-xs text-[#0E1F38]/70 leading-relaxed mt-0.5 font-light\">{step.desc}</p>\n                </div>\n              </div>\n            ))}\n          </div>\n        </div>\n      </section>\n\n      {/* ───────────────────────────────────────\n          SECTION 2: HOW LAYO WORKS (4-Step Grid)\n      ─────────────────────────────────────── */}\n      <section className=\"py-20 px-6 md:px-16 bg-[#ECEAE0] border-y border-black/5\">\n        <div className=\"max-w-5xl w-full mx-auto space-y-12\">\n          <div className=\"text-center space-y-3 max-w-2xl mx-auto\">\n            <h2 className=\"text-3xl md:text-5xl font-black tracking-tight text-[#0E1F38]\">\n              How <span className=\"text-[#FF5A65] italic font-serif-luxury font-medium\">Layo</span> Works\n            </h2>\n            <p className=\"text-sm md:text-base text-[#0E1F38]/70 font-light leading-relaxed\">\n              Every order you place in India lands safely in your own Layo warehouse locker — ready to combine, pack, and send whenever you are.\n            </p>\n          </div>\n\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6\">\n            <div className=\"bg-white border border-black/5 rounded-3xl p-6 flex flex-col space-y-4 shadow-sm hover:shadow-md transition-shadow\">\n              <div className=\"flex justify-between items-center\">\n                <span className=\"text-2xl font-black text-[#FF5A65]\">01</span>\n                <span className=\"text-2xl\">📍</span>\n              </div>\n              <h3 className=\"text-lg font-bold text-[#0E1F38]\">Route Your Packages</h3>\n              <p className=\"text-xs text-[#0E1F38]/75 leading-relaxed font-light\">Whether you are shopping online or offline, or receiving a personal package, simply use your provided warehouse address as your delivery destination.</p>\n            </div>\n            <div className=\"bg-white border border-black/5 rounded-3xl p-6 flex flex-col space-y-4 shadow-sm hover:shadow-md transition-shadow\">\n              <div className=\"flex justify-between items-center\">\n                <span className=\"text-2xl font-black text-[#FF5A65]\">02</span>\n                <span className=\"text-2xl\">🏷️</span>\n              </div>\n              <h3 className=\"text-lg font-bold text-[#0E1F38]\">Categorize & Customize</h3>\n              <p className=\"text-xs text-[#0E1F38]/75 leading-relaxed font-light\">Ditch the guesswork by simply categorizing your items for a smart, data-driven weight estimate. Don&apos;t forget your lightweight &quot;Extras&quot;!</p>\n            </div>\n            <div className=\"bg-white border border-black/5 rounded-3xl p-6 flex flex-col space-y-4 shadow-sm hover:shadow-md transition-shadow\">\n              <div className=\"flex justify-between items-center\">\n                <span className=\"text-2xl font-black text-[#FF5A65]\">03</span>\n                <span className=\"text-2xl\">🔄</span>\n              </div>\n              <h3 className=\"text-lg font-bold text-[#0E1F38]\">Ship, Hold & Combine</h3>\n              <p className=\"text-xs text-[#0E1F38]/75 leading-relaxed font-light\">Ship immediately, or optionally choose to hold your items to combine them with up to 3 additional incoming packages.</p>\n            </div>\n            <div className=\"bg-white border border-black/5 rounded-3xl p-6 flex flex-col space-y-4 shadow-sm hover:shadow-md transition-shadow\">\n              <div className=\"flex justify-between items-center\">\n                <span className=\"text-2xl font-black text-[#FF5A65]\">04</span>\n                <span className=\"text-2xl\">🚚</span>\n              </div>\n              <h3 className=\"text-lg font-bold text-[#0E1F38]\">Ship & Track</h3>\n              <p className=\"text-xs text-[#0E1F38]/75 leading-relaxed font-light\">Review your finalized, cost-effective shipment, complete your payment, and track your smart haul right to your doorstep.</p>\n            </div>\n          </div>\n\n          <div className=\"text-center pt-4\">\n            <button\n              onClick={() => setModalOpen(true)}\n              className=\"px-8 py-3.5 bg-[#FF5A65] text-white font-bold text-xs uppercase tracking-wider rounded-xl hover:bg-[#E24550] transition-all shadow-sm cursor-pointer\"\n            >\n              Calculate Your Shipping\n            </button>\n          </div>\n        </div>\n      </section>\n\n      {/* ───────────────────────────────────────\n          SECTION 3: ABOUT LAYO\n      ─────────────────────────────────────── */}\n      <section ref={aboutRef} className=\"py-24 px-6 md:px-16 bg-[#FAF8EE]\">\n        <div className=\"max-w-5xl w-full mx-auto\">\n          <div className=\"bg-[#0E1F38] text-white rounded-3xl p-8 md:p-14 space-y-8 shadow-xl\">\n            <h2 className=\"text-3xl md:text-5xl font-black text-white tracking-tight\">About Layo</h2>\n\n            <div className=\"space-y-4 text-sm md:text-base text-gray-200 font-light leading-relaxed border-b border-white/15 pb-8\">\n              <p className=\"font-medium text-white\">\n                Shipping shouldn&apos;t be a rigid, expensive hurdle. It should adapt to how you actually shop and live.\n              </p>\n              <p>\n                At Layo, we&apos;ve built a smart logistics platform designed to give you total control over your shipments. Whether you are routing everyday retail essentials, building a seasonal haul, or sending personal packages from home, we transform complex international shipping into a simple, stress-free experience.\n              </p>\n              <p>\n                We believe in fair shipping. To keep your deliveries affordable and minimize volumetric weight, we employ strategic packing techniques, which includes vacuum-sealing bulky apparel whenever necessary to save space.\n              </p>\n              <p>\n                From giving you the power to hold and combine multiple packages to introducing weight-free &quot;Extras,&quot; every feature we build is designed to optimize your shipping journey and maximize your value.\n              </p>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      {/* ───────────────────────────────────────\n          SECTION 4: FREQUENTLY ASKED QUESTIONS\n      ─────────────────────────────────────── */}\n      <section ref={faqRef} className=\"py-20 px-6 md:px-16 bg-[#ECEAE0] border-t border-black/5\">\n        <div className=\"max-w-4xl w-full mx-auto space-y-10\">\n          <div className=\"text-center space-y-3\">\n            <h2 className=\"text-3xl md:text-5xl font-black text-[#0E1F38] tracking-tight\">\n              Frequently Asked Questions\n            </h2>\n            <p className=\"text-sm text-[#0E1F38]/60\">\n              Everything you need to know about shipping, holding, and estimates.\n            </p>\n          </div>\n\n          <div className=\"space-y-3\">\n            {FAQS_LIST.map((faq, idx) => {\n              const isOpen = openFaqIdx === idx;\n              return (\n                <div\n                  key={idx}\n                  className=\"bg-white border border-black/5 rounded-2xl overflow-hidden transition-all shadow-sm\"\n                >\n                  <button\n                    onClick={() => setOpenFaqIdx(isOpen ? null : idx)}\n                    className=\"w-full px-6 py-4 flex items-center justify-between text-left font-bold text-sm text-[#0E1F38] hover:text-[#FF5A65] cursor-pointer gap-4\"\n                  >\n                    <span>{faq.q}</span>\n                    <span className=\"w-7 h-7 rounded-full bg-[#FAF8EE] text-[#FF5A65] flex items-center justify-center font-bold text-base flex-shrink-0\">\n                      {isOpen ? '-' : '+'}\n                    </span>\n                  </button>\n                  {isOpen && (\n                    <div className=\"px-6 pb-5 pt-1 text-xs text-[#0E1F38]/70 leading-relaxed border-t border-black/5 bg-[#fdfbf5]\">\n                      {faq.a}\n                    </div>\n                  )}\n                </div>\n              );\n            })}\n          </div>\n\n          <div className=\"text-center pt-6 space-y-4\">\n            <p className=\"text-sm font-bold text-[#0E1F38]\">\n              Got more questions? Get in touch with us directly!\n            </p>\n          </div>\n        </div>\n      </section>\n\n      {/* ───────────────────────────────────────\n          SECTION 5: GET IN TOUCH WITH US HERE\n      ─────────────────────────────────────── */}\n      <section ref={contactRef} id=\"contact\" className=\"py-24 px-6 md:px-16 bg-[#E7F7D3] border-t border-black/5 scroll-mt-16\">\n        <div className=\"max-w-4xl w-full mx-auto space-y-10\">\n          <div className=\"text-center space-y-2\">\n            <h2 className=\"text-3xl md:text-5xl font-black text-[#0E1F38] tracking-tight\">\n              Get In Touch With Us Here\n            </h2>\n          </div>\n\n          <div className=\"bg-white border border-[#D5E9C0] rounded-3xl p-8 md:p-12 shadow-md space-y-6\">\n            {contactSubmitted ? (\n              <div className=\"p-6 bg-green-50 border border-green-200 text-green-800 rounded-2xl text-center space-y-2\">\n                <span className=\"material-symbols-outlined text-3xl text-green-600\">check_circle</span>\n                <h3 className=\"font-bold text-base\">Thank you for reaching out!</h3>\n                <p className=\"text-xs text-green-700\">Our support team will get back to you within 24 hours.</p>\n              </div>\n            ) : (\n              <form onSubmit={handleContactSubmit} className=\"space-y-4\">\n                <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                  <input\n                    type=\"text\"\n                    value={contactForm.name}\n                    onChange={(e) => setContactForm({ ...contactForm, name: e.target.value })}\n                    placeholder=\"Name\"\n                    className=\"w-full px-4 py-3.5 bg-[#fdfbf5] border border-black/5 rounded-xl text-sm text-[#0E1F38] placeholder:text-black/40 focus:outline-none focus:border-[#FF5A65]\"\n                    required\n                  />\n                  <input\n                    type=\"text\"\n                    value={contactForm.contact}\n                    onChange={(e) => setContactForm({ ...contactForm, contact: e.target.value })}\n                    placeholder=\"Phone/Email\"\n                    className=\"w-full px-4 py-3.5 bg-[#fdfbf5] border border-black/5 rounded-xl text-sm text-[#0E1F38] placeholder:text-black/40 focus:outline-none focus:border-[#FF5A65]\"\n                    required\n                  />\n                </div>\n                <textarea\n                  rows={4}\n                  value={contactForm.message}\n                  onChange={(e) => setContactForm({ ...contactForm, message: e.target.value })}\n                  placeholder=\"Message\"\n                  className=\"w-full px-4 py-3.5 bg-[#fdfbf5] border border-black/5 rounded-xl text-sm text-[#0E1F38] placeholder:text-black/40 focus:outline-none focus:border-[#FF5A65]\"\n                />\n                <button\n                  type=\"submit\"\n                  className=\"w-full py-4 bg-[#0E1F38] hover:bg-[#060D18] text-white font-bold text-xs uppercase tracking-widest rounded-xl transition-all shadow-md cursor-pointer\"\n                >\n                  Submit\n                </button>\n              </form>\n            )}\n\n            {/* Address */}\n            <div className=\"border-t border-black/5 pt-6 space-y-4\">\n              <div className=\"w-full bg-[#e5eee0] border border-[#cbe0c2] rounded-2xl relative overflow-hidden flex flex-col p-2\">\n                <div className=\"absolute inset-0 bg-[radial-gradient(#a3c993_1px,transparent_1px)] [background-size:16px_16px] opacity-40 pointer-events-none\" />\n                \n                <div className=\"relative z-10 flex flex-col items-center text-center p-2 mb-2\">\n                  <span className=\"material-symbols-outlined text-2xl text-[#FF5A65]\">location_on</span>\n                  <span className=\"text-xs font-bold text-[#0E1F38] mt-1\">Layo Delhi Warehouse</span>\n                  <span className=\"text-[10px] text-[#0E1F38]/60\">Delhi NCR &amp; Mumbai, India | Toronto, Canada</span>\n                </div>\n                \n                <div className=\"relative z-10 w-full h-48 md:h-64 rounded-xl overflow-hidden shadow-sm border border-[#a3c993]/30\">\n                  <iframe\n                    src=\"https://maps.google.com/maps?q=C-N-246,+Bamnoli+Village,+Sector+28+Dwarka,+Dwarka,+New+Delhi,+Delhi+110077&t=&z=14&ie=UTF8&iwloc=&output=embed\"\n                    width=\"100%\"\n                    height=\"100%\"\n                    style={{ border: 0 }}\n                    allowFullScreen\n                    loading=\"lazy\"\n                    referrerPolicy=\"no-referrer-when-downgrade\"\n                  />\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      {/* ── FOOTER ── */}\n      <footer className=\"bg-[#ECEAE0] border-t border-black/10 py-12 px-6 md:px-16 text-[#0E1F38]\">\n        <div className=\"max-w-5xl mx-auto space-y-8\">\n          <div className=\"flex flex-col md:flex-row justify-between items-start md:items-center gap-6 border-b border-black/10 pb-8\">\n            <div className=\"space-y-1\">\n              <h3 className=\"text-2xl font-bold tracking-tight text-[#0E1F38]\">\n                Indian Shipping Made Easy.\n              </h3>\n              <p className=\"text-xs text-[#0E1F38]/60\">Consolidating purchases, cutting logistics costs, bringing India closer.</p>\n            </div>\n            <div className=\"flex flex-wrap gap-4 text-xs font-bold uppercase tracking-wider text-[#0E1F38]/60\">\n              <Link href=\"/shipping-policy\" className=\"hover:text-black transition-colors\">Shipping Policy</Link>\n              <Link href=\"/privacy\" className=\"hover:text-black transition-colors\">Privacy Policy</Link>\n              <Link href=\"/refund-policy\" className=\"hover:text-black transition-colors\">Refund Policy</Link>\n              <Link href=\"/terms\" className=\"hover:text-black transition-colors\">Terms & Conditions</Link>\n              <Link href=\"/faq\" className=\"hover:text-black transition-colors\">FAQs</Link>\n            </div>\n          </div>\n          <div className=\"flex flex-col sm:flex-row justify-between items-center gap-4 text-xs text-[#0E1F38]/60\">\n            <p>© 2026 Layo Technologies Inc. All rights reserved.</p>\n            <p className=\"text-[10px] italic\">Layo is a parcel forwarding service provider.</p>\n          </div>\n        </div>\n      </footer>\n\n      {/* Estimator Modal */}\n      <EstimatorModal isOpen={modalOpen} onClose={() => setModalOpen(false)} />\n\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/sharma/Desktop/Misc/Layo/src/app/layo-logic/page.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/sharma/Desktop/Misc/Layo/src/app/layout.t